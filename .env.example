# Telegram Bot Token from @BotFather
TELOXIDE_TOKEN=replace-with-botfather-token

# Alert destination and the only chat permitted to use commands
TELEGRAM_CHAT_ID=-1001234567890

# Required 9router deployment base URL
ROUTER_URL=https://router.example.com

# Dashboard password; bot obtains and refreshes auth_token automatically
ROUTER_PASSWORD=replace-with-dashboard-password

# Optional: API key for pinging /v1 endpoint (e.g. sk-...)
# If not provided, /v1 ping verifies HTTP reachability (< 500)
ROUTER_API_KEY=

# Polling delay after each cycle in seconds (default: 300)
POLL_INTERVAL_SECS=300
